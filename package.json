{
  "name": "snowman",
  "version": "2.1.4",
  "description": "An advanced story format for authors more experienced with HTML, CSS, and JavaScript. See its <a href='https://videlais.github.io/snowman/2/' target='_blank' rel='noopener noreferrer'>documentation</a>.",
  "license": "MIT",
  "repository": "https://github.com/videlais/snowman/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "test:html": "jest --config jest.config.extended.cjs",
    "test:playwright": "playwright test test/playwright/cookbook/**/*.test.js --reporter=list",
    "test:full": "npm run test && npm run test:html && npm run test:playwright",
    "lint": "eslint lib/*.js lib/**/*.js test/**/*.js scripts/**/*.js --fix",
    "build": "webpack --config webpack.config.cjs",
    "compile": "node scripts/build-format.js",
    "all": "npm run lint && npm run test && npm run build && npm run compile"
  },
  "keywords": [
    "twine",
    "storyformat"
  ],
  "author": "Dan Cox",
  "dependencies": {
    "jquery": "^4.0.0",
    "jsdom": "^30.0.1",
    "lz-string": "^1.5.0",
    "markdown-it": "^15.0.0",
    "marked": "^18.0.6",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@playwright/test": "^1.61.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "baseline-browser-mapping": "^2.10.43",
    "css-loader": "^7.1.4",
    "diff": "^9.0.0",
    "ejs": "^6.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-jest": "^29.15.4",
    "extwee": "^2.3.18",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "shelljs": "^0.10.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.108.4",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.2.1"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./lib/index.js"
  ],
  "overrides": {
    "js-yaml": "^4.1.2"
  }
}
